# Copy to .env and fill in. Never commit the real .env.

# --- LLM ---
# Used by the Planner, Implementation Agent, Test Agent (failure summarizing),
# and Diff+Explain LLM calls.
ANTHROPIC_API_KEY=

# --- Embeddings (Phase 1) ---
# Default is local sentence-transformers — no key needed. Left here in case
# we switch to a hosted embedding provider later (see BUILD_SUMMARY.md for
# why we didn't start there).
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# --- Target repo + sandbox ---
# Path to the target repo's source as seen from the RepoAgent host process.
TARGET_REPO_PATH=./target_repo/src

# docker-compose service name the sandbox tools (write_file, run_tests,
# run_linter) exec into. Must match docker-compose.yml.
SANDBOX_SERVICE=sandbox

# Must match docker-compose.yml's db service credentials — the target repo
# itself needs this to boot (see target_repo/src/app/db.py).
DATABASE_URL=postgresql://hello_fastapi:hello_fastapi@db/hello_fastapi_dev

# --- Test-and-retry loop (ARCHITECTURE.md) ---
MAX_RETRIES=3
